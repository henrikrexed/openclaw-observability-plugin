{
  "version": 7,
  "variables": [],
  "tiles": {
    "0": {
      "type": "markdown",
      "title": "",
      "content": "# 🎩 OpenClaw AI Agent Observability\n\nReal-time monitoring of AI agent operations, token usage, costs, and security."
    },
    "1": {
      "type": "data",
      "title": "Total Agents Active",
      "query": "timeseries count = count(gen_ai.client.operation.duration), by:{gen_ai.agent.name}\n| summarize agents = countDistinct(gen_ai.agent.name)",
      "queryConfig": {
        "additionalFilters": {},
        "version": "4.3.1",
        "datatype": "metrics"
      },
      "subType": "singleValue",
      "visualization": "singleValue",
      "visualizationSettings": {
        "thresholds": [],
        "chartSettings": {
          "gapPolicy": "connect"
        },
        "singleValue": {
          "showLabel": true,
          "label": "Active Agents",
          "prefixIcon": "UserGroupIcon"
        }
      }
    },
    "2": {
      "type": "data",
      "title": "Monthly Token Cost (USD)",
      "query": "timeseries cost = sum(paperclip.cost.cents)\n| fieldsAdd cost_sum = arraySum(cost)\n| summarize total_cents = sum(cost_sum)\n| fieldsAdd total_cost = round(total_cents / 100, decimals: 2)\n| fields total_cost",
      "subType": "singleValue",
      "visualization": "singleValue",
      "visualizationSettings": {
        "thresholds": [
          { "field": "total_cost", "title": "Cost", "isEnabled": true, "rules": [
            { "color": { "Default": "#7dc540" }, "comparator": "≥", "value": 0 },
            { "color": { "Default": "#f5d30f" }, "comparator": "≥", "value": 50 },
            { "color": { "Default": "#dc172a" }, "comparator": "≥", "value": 200 }
          ]}
        ],
        "singleValue": {
          "showLabel": true,
          "label": "Monthly Cost",
          "prefixIcon": "CostsIcon",
          "autoscale": true
        }
      }
    },
    "3": {
      "type": "data",
      "title": "Avg Agent Health Score",
      "query": "timeseries avg_health = avg(paperclip.agent.health.score), by:{agent_name}\n| fieldsAdd agent_avg = arrayAvg(avg_health)\n| summarize overall = avg(agent_avg)",
      "subType": "singleValue",
      "visualization": "singleValue",
      "visualizationSettings": {
        "thresholds": [
          { "field": "overall", "title": "Health", "isEnabled": true, "rules": [
            { "color": { "Default": "#dc172a" }, "comparator": "≥", "value": 0 },
            { "color": { "Default": "#f5d30f" }, "comparator": "≥", "value": 50 },
            { "color": { "Default": "#7dc540" }, "comparator": "≥", "value": 80 }
          ]}
        ],
        "singleValue": {
          "showLabel": true,
          "label": "Health Score",
          "prefixIcon": "HealthIcon"
        }
      }
    },
    "4": {
      "type": "data",
      "title": "Active Issues",
      "query": "timeseries issues = avg(paperclip.issues.count), by:{status}\n| fieldsAdd latest = arrayLast(issues)\n| summarize total = sum(latest)",
      "subType": "singleValue",
      "visualization": "singleValue",
      "visualizationSettings": {
        "singleValue": {
          "showLabel": true,
          "label": "Active Issues",
          "prefixIcon": "LogsWarningIcon"
        }
      }
    },
    "5": {
      "type": "markdown",
      "title": "",
      "content": "## 📊 Token Usage"
    },
    "6": {
      "type": "data",
      "title": "Token Usage by Model & Type",
      "query": "timeseries usage = sum(gen_ai.client.token.usage), by:{gen_ai.token.type, gen_ai.request.model}",
      "visualization": "categoricalBarChart",
      "visualizationSettings": {
        "chartSettings": {
          "categoricalBarChartSettings": {
            "categoryAxis": "gen_ai.request.model",
            "categoryAxisLabel": "Model",
            "valueAxis": "usage",
            "valueAxisLabel": "Tokens"
          }
        }
      }
    },
    "7": {
      "type": "data",
      "title": "Token Usage Over Time (Input vs Output)",
      "query": "timeseries {\n  input_tokens = sum(gen_ai.client.token.usage, filter: { gen_ai.token.type == \"input\" }, default: 0),\n  output_tokens = sum(gen_ai.client.token.usage, filter: { gen_ai.token.type == \"output\" }, default: 0)\n}",
      "visualization": "lineChart",
      "visualizationSettings": {
        "chartSettings": {
          "legend": { "position": "bottom" },
          "leftYAxisSettings": { "label": "Tokens" }
        }
      }
    },
    "8": {
      "type": "data",
      "title": "Cache Hit Rate",
      "query": "timeseries {\n  cache_read = sum(gen_ai.client.token.usage, filter: { gen_ai.token.type == \"cache_read\" }, default: 0),\n  input = sum(gen_ai.client.token.usage, filter: { gen_ai.token.type == \"input\" }, default: 0)\n}\n| fieldsAdd cache_rate = 100 * cache_read[] / (input[] + 0.000001)",
      "visualization": "lineChart",
      "visualizationSettings": {
        "chartSettings": {
          "leftYAxisSettings": { "label": "Cache Hit %" }
        }
      }
    },
    "9": {
      "type": "markdown",
      "title": "",
      "content": "## 💰 Cost by Agent"
    },
    "10": {
      "type": "data",
      "title": "Cost by Agent (USD)",
      "query": "timeseries cost = sum(paperclip.cost.cents), by:{agent_id, model}\n| fieldsAdd cost_usd = cost[] / 100",
      "visualization": "barChart",
      "visualizationSettings": {
        "chartSettings": {
          "legend": { "position": "right" },
          "leftYAxisSettings": { "label": "Cost (USD)" }
        }
      }
    },
    "11": {
      "type": "data",
      "title": "Cost Trend — Last 30 Days",
      "query": "timeseries cost_cents = sum(paperclip.cost.cents), by:{model}\n| fieldsAdd cost_usd = cost_cents[] / 100\n| fieldsAdd cumulative = arrayCumulativeSum(cost_usd)",
      "visualization": "areaChart",
      "visualizationSettings": {
        "chartSettings": {
          "legend": { "position": "bottom" },
          "leftYAxisSettings": { "label": "Cumulative Cost (USD)" }
        }
      }
    },
    "12": {
      "type": "markdown",
      "title": "",
      "content": "## ⚡ Agent Performance"
    },
    "13": {
      "type": "data",
      "title": "Operation Duration by Provider",
      "query": "timeseries avg_duration = avg(gen_ai.client.operation.duration), by:{gen_ai.provider.name}",
      "visualization": "lineChart",
      "visualizationSettings": {
        "chartSettings": {
          "legend": { "position": "bottom" },
          "leftYAxisSettings": { "label": "Duration (s)" }
        }
      }
    },
    "14": {
      "type": "data",
      "title": "P95 Operation Duration",
      "query": "timeseries p95 = percentile(gen_ai.client.operation.duration, 95), by:{gen_ai.provider.name}, rollup: avg",
      "visualization": "lineChart",
      "visualizationSettings": {
        "chartSettings": {
          "leftYAxisSettings": { "label": "P95 Duration (s)" }
        }
      }
    },
    "17": {
      "type": "markdown",
      "title": "",
      "content": "## 📋 Issue Flow"
    },
    "18": {
      "type": "data",
      "title": "Issues by Status Over Time",
      "query": "timeseries issues = avg(paperclip.issues.count), by:{status}",
      "visualization": "areaChart",
      "visualizationSettings": {
        "chartSettings": {
          "legend": { "position": "bottom" },
          "leftYAxisSettings": { "label": "Issues" }
        }
      }
    },
    "19": {
      "type": "data",
      "title": "Issue Completion Rate",
      "query": "timeseries {\n  done = avg(paperclip.issues.count, filter: { status == \"done\" }, default: 0),\n  total = avg(paperclip.issues.count, default: 0)\n}\n| fieldsAdd completion_rate = 100 * done[] / (total[] + 0.000001)",
      "visualization": "lineChart",
      "visualizationSettings": {
        "chartSettings": {
          "leftYAxisSettings": { "label": "Completion %" }
        }
      }
    }
  },
  "layouts": {
    "0": { "x": 0, "y": 0, "w": 24, "h": 2 },
    "1": { "x": 0, "y": 2, "w": 6, "h": 4 },
    "2": { "x": 6, "y": 2, "w": 6, "h": 4 },
    "3": { "x": 12, "y": 2, "w": 6, "h": 4 },
    "4": { "x": 18, "y": 2, "w": 6, "h": 4 },
    "5": { "x": 0, "y": 6, "w": 24, "h": 1 },
    "6": { "x": 0, "y": 7, "w": 12, "h": 6 },
    "7": { "x": 12, "y": 7, "w": 12, "h": 6 },
    "8": { "x": 0, "y": 13, "w": 24, "h": 5 },
    "9": { "x": 0, "y": 18, "w": 24, "h": 1 },
    "10": { "x": 0, "y": 19, "w": 12, "h": 6 },
    "11": { "x": 12, "y": 19, "w": 12, "h": 6 },
    "12": { "x": 0, "y": 25, "w": 24, "h": 1 },
    "13": { "x": 0, "y": 26, "w": 12, "h": 6 },
    "14": { "x": 12, "y": 26, "w": 12, "h": 6 },
    "17": { "x": 0, "y": 32, "w": 24, "h": 1 },
    "18": { "x": 0, "y": 33, "w": 14, "h": 6 },
    "19": { "x": 14, "y": 33, "w": 10, "h": 6 }
  }
}
