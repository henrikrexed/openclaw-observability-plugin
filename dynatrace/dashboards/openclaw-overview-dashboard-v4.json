      "9": {"x": 12, "y": 13, "w": 12, "h": 6},
      "10": {"x": 0, "y": 19, "w": 24, "h": 1},
      "11": {"x": 0, "y": 20, "w": 12, "h": 6},
      "12": {"x": 12, "y": 20, "w": 6, "h": 6},
      "13": {"x": 18, "y": 20, "w": 6, "h": 6},
      "14": {"x": 0, "y": 26, "w": 24, "h": 1},
